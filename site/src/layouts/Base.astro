---
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/site.css";
import "../styles/lower.css";
import "../styles/header.css";
import { t, url, EMAIL, type Lang } from "../lib";

interface Props { lang: Lang; title: string; description: string; path: string; current?: string }
const { lang, title, description, path, current } = Astro.props;
const s = t(lang);
const other: Lang = lang === "en" ? "ar" : "en";
const home = url(lang === "ar" ? "ar/" : "");
const self = url((lang === "ar" ? "ar/" : "") + path);
const alt = url((other === "ar" ? "ar/" : "") + path);
const canonical = new URL(self, Astro.site).href;
const altAbs = new URL(alt, Astro.site).href;
const enAbs = new URL(url(path), Astro.site).href;
const arAbs = new URL(url("ar/" + path), Astro.site).href;
const og = new URL(url(lang === "ar" ? "img/og-ar.png" : "img/og.png"), Astro.site).href;
const person = {
  "@type": "Person",
  "@id": new URL(url("#person"), Astro.site).href,
  name: "Islam Nasser",
  alternateName: ["إسلام ناصر", "Eslam Nasser", "Eslam Abdel Nasser"],
  jobTitle: t("en").role,
  url: new URL(url(""), Astro.site).href,
  email: `mailto:${EMAIL}`,
  image: og,
  knowsLanguage: ["ar", "en"],
  address: { "@type": "PostalAddress", addressLocality: "10th of Ramadan City", addressCountry: "EG" },
  worksFor: { "@type": "Organization", name: "TakTek" },
  sameAs: ["https://github.com/imsemoo", "https://www.linkedin.com/in/imsemooo/", "https://www.behance.net/eslamnasserui", "https://dribbble.com/imsemoo2", "https://www.upwork.com/freelancers/imsemoo", "https://mostaql.com/u/imsemoo/portfolio"],
};
const ld = { "@context": "https://schema.org", "@graph": [person, { "@type": "WebPage", "@id": canonical, url: canonical, name: title, description, inLanguage: lang, about: { "@id": person["@id"] }, isPartOf: { "@type": "WebSite", name: "Islam Nasser", url: new URL(url(""), Astro.site).href } }] };
/* the tab icon: the section mark, a line cut by a diamond, on ink */
const favicon = "data:image/svg+xml," + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" rx="5" fill="#0f1115"/><rect x="14.5" y="5" width="3" height="22" fill="#f4f5f7"/><rect x="10.5" y="10.5" width="11" height="11" transform="rotate(45 16 16)" fill="#5fd3a5"/></svg>');
---
<!doctype html>
<html lang={lang} dir={s.dir}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="alternate" hreflang="en" href={enAbs}>
<link rel="alternate" hreflang="ar" href={arAbs}>
<link rel="alternate" hreflang="x-default" href={enAbs}>
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:locale" content={lang === "ar" ? "ar_AR" : "en_GB"}>
<meta property="og:image" content={og}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={lang === "ar" ? "إسلام ناصر: ما توافق عليه في التصميم هو ما يُنفَّذ." : "Islam Nasser: what you approve in the design is what ships."}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={og}>
<meta name="theme-color" content="#0c0e12">
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
<link rel="icon" href={favicon}>
<link rel="preload" as="font" type="font/woff2" href={url(lang === "ar" ? "fonts/vazirmatn-arabic.woff2" : "fonts/schibsted-grotesk-latin.woff2")} crossorigin>
<script is:inline>try{var m=localStorage.getItem("theme");if(m&&m!=="system")document.documentElement.setAttribute("data-theme",m)}catch(e){}</script>
</head>
<body>
<a class="skip" href="#top">{s.skip}</a>
<header class="bar" data-bar><div class="shell bar__in">
  <a class="logo" href={home} aria-label={lang === "ar" ? "إسلام ناصر، الصفحة الرئيسية" : "Islam Nasser, home"}>
    <span class="logo__name" lang={lang}>{lang === "ar" ? "إسلام ناصر" : "Islam Nasser"}</span>
    <span class="logo__cut" aria-hidden="true"></span>
    <span class="logo__name logo__name--other" lang={other} aria-hidden="true">{lang === "ar" ? "Islam Nasser" : "إسلام ناصر"}</span>
  </a>
  <nav class="bar__nav" aria-label={lang === "ar" ? "الأقسام" : "Sections"}>
    {s.nav.map(([n, h]: [string, string]) => <a href={`${home}${h}`} aria-current={current === h ? "page" : undefined}>{n}</a>)}
  </nav>
  <div class="bar__end">
    <a class="lang" href={alt} hreflang={other} lang={other} data-lang-link>{s.other}</a>
    <button class="icon-btn" type="button" data-theme-btn aria-label={lang === "ar" ? "المظهر" : "Theme"}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor"/></svg></button>
    <a class="bar__cta" href={`mailto:${EMAIL}`}>{s.email_btn}<svg viewBox="0 0 20 12" aria-hidden="true"><path d="M1 6h17M13 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.7"/></svg></a>
  </div>
</div></header>
<slot />
<footer class="foot"><div class="shell">
  <p>{s.name} · {lang === "ar" ? "مبنيّ بـ" : "Built with "}<bdi>Astro</bdi>{lang === "ar" ? "، ومن دون سكربتات خارجية." : ", with no third-party scripts."}</p>
  <p><a href="https://www.linkedin.com/in/imsemooo/">LinkedIn</a> · <a href="https://github.com/imsemoo">GitHub</a> · <a href="https://www.behance.net/eslamnasserui">Behance</a> · <a href="https://dribbble.com/imsemoo2">Dribbble</a></p>
</div></footer>
<script src="../scripts/site.js"></script>
</body>
</html>
